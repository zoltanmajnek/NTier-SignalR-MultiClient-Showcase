<Window x:Class="CABTEX_HFT_2023241.WpfClient.MyDisks"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CABTEX_HFT_2023241.WpfClient"
        mc:Ignorable="d"
        Title="My Disks" Height="450" Width="800">
    <Window.DataContext>
        <local:MyDisksViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <ListBox ItemsSource="{Binding MyDisks}" SelectedItem="{Binding SelectedMyDisk}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Label Content="{Binding Label}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Column="1">
            <Label Content="Name" Background="LightBlue" Padding="10" />
            <TextBox Text="{Binding SelectedMyDisk.Label}" Padding="10" Margin="0,0,0,30" />
            <Button Content="Create MyDisk" Command="{Binding CreateMyDiskCommand}" Margin="10" Padding="10" />
            <Button Content="Delete MyDisk" Command="{Binding DeleteMyDiskCommand}" Margin="10" Padding="10" />
            <Button Content="Update MyDisk" Command="{Binding UpdateMyDiskCommand}" Margin="10" Padding="10" />
            <Label Content="{Binding ErrorMessage}" FontSize="18" Foreground="Red" HorizontalContentAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
