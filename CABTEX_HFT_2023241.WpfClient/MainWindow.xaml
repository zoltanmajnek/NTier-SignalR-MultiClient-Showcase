<Window Closing="Window_Closing" x:Class="CABTEX_HFT_2023241.WpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CABTEX_HFT_2023241.WpfClient"
        mc:Ignorable="d"
        Title="CABTEX WpfClient" Height="300" Width="200" WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="8*"/>
        </Grid.RowDefinitions>
        <Label Content="Katalógus Main Menu"></Label>
            <ContentControl Grid.Row="1" FontSize="20" FontWeight="Normal"   >
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                    <Label FontSize="20" Grid.Row="1" Content="Select a Table" HorizontalAlignment="Center"></Label>
                    <Button Content="Disks" Height="28" Width="140" Click="OpenMyDisks"/>
                    <Button Content="Friends" Height="28" Width="140" Click="OpenFriends"/>
                    <Button Content="Types" Height="28" Width="140" Click="OpenDiskTypeWindow"/>
                    <Button Content="Software" Height="28" Width="140" Click="OpenSwWindow"/>
                    <Button Content="Directories" Height="28" Width="140" Click="DirectoriesInfo"/>
                    <Button Content="NonCruds" Height="28" Width="140" Click="OpenNonCrudWindow"/>
                </StackPanel>
            </ContentControl>
    </Grid>
</Window>
