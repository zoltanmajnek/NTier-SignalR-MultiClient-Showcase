<Window x:Class="CABTEX_HFT_2023241.WpfClient.NonCrudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CABTEX_HFT_2023241.WpfClient"
        mc:Ignorable="d"
        Title="NonCrudWindow" Height="450" Width="800">
    <Window.DataContext>
        <local:NonCrudWindowViewModel />
    </Window.DataContext>

    <Grid>
        <StackPanel>
            <Label Content="Keresendő szöveg:" Padding="10" Background="LightBlue"/>
            <TextBox Text="{Binding InputText, Mode=TwoWay}" Padding="10" Margin="0,0,0,0"/>
            <ListBox ItemsSource="{Binding Result}">
            </ListBox>
            <Button Content="Lakcímre keres" Command="{Binding AddressSearch}" Margin="5" Padding="10" />
            <Button Content="Játéktípusra keres" Command="{Binding GenreSearch}" Margin="5" Padding="10" />
            <Button Content="Kinél és melyik lemezen van a szoftver" Command="{Binding SwSearch}" Margin="5" Padding="10" />
            <Label Content="{Binding ErrorMessage}" FontSize="18" Foreground="Red" HorizontalContentAlignment="Center" />
        </StackPanel>

    </Grid>
</Window>
