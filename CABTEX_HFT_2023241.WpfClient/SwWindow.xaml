<Window x:Class="CABTEX_HFT_2023241.WpfClient.SwWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CABTEX_HFT_2023241.WpfClient"
        mc:Ignorable="d"
        Title="Softwares" Height="520" Width="800">
    <Window.DataContext>
        <local:SwWindowViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <ListBox ItemsSource="{Binding Softwares}" SelectedItem="{Binding SelectedSoftware}" SelectionChanged="ListBox_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Label Content="{Binding Name}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Column="1">
            <Label Content="Name" Background="LightBlue" Padding="10" />
            <TextBox Text="{Binding SelectedSoftware.Name}" Padding="10" Margin="0,0,0,0" />
            <Label Content="Creator" Background="LightBlue" Padding="10" />
            <TextBox Text="{Binding SelectedSoftware.Creator}" Padding="10" Margin="0,0,0,0" />
            <Label Content="Genre" Background="LightBlue" Padding="10" />
            <TextBox Text="{Binding SelectedSoftware.Genre}" Padding="10" Margin="0,0,0,0" />
            <Label Content="Size" Background="LightBlue" Padding="10" />
            <TextBox Text="{Binding SelectedSoftware.Size}" Padding="10" Margin="0,0,0,0" PreviewKeyDown="TextBox_PreviewKeyDown"/>            
            <Button Content="Create Software" Command="{Binding CreateSoftwareCommand}" Margin="10" Padding="10" />
            <Button Content="Delete Software" Command="{Binding DeleteSoftwareCommand}" Margin="10" Padding="10" />
            <Button Content="Update Software" Command="{Binding UpdateSoftwareCommand}" Margin="10" Padding="10" />
            <Label Content="{Binding ErrorMessage}" FontSize="18" Foreground="Red" HorizontalContentAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
